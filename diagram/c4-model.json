  "c4": {
    "decisions": [
      {
        "q": "Where does the system boundary sit?",
        "choice": "One software system: the dev-skills plugin as installed.",
        "by": "user",
        "why": "Single repo, single owner, everything ships together \u2014 the ownership and deployment-alignment heuristic (c4-model.md 2.2)."
      },
      {
        "q": "Which containers earn a component view?",
        "choice": "Skill definitions only.",
        "by": "user",
        "why": "It is the only container with internal structure worth decomposing; C4 5.1 warns component views are the fastest to rot."
      },
      {
        "q": "Container or component: an individual skill?",
        "choice": "Component \u2014 one box per skill, all nineteen.",
        "by": "skill",
        "why": "A skill is not separately deployable \u2014 it is loaded into the agent's context \u2014 so the deployability test (2.4) makes it a component. A hook script runs as its own process, so it is a container."
      },
      {
        "q": "How are the nineteen skills grouped?",
        "choice": "Nine dashed boundary rectangles; the groups are not elements.",
        "by": "skill",
        "why": "A functional group is an organisational grouping, not an abstraction level (2.6, 11). Collapsing each group into a single component would hide every skill and put a fifth level in by the back door."
      },
      {
        "q": "Are templates a container?",
        "choice": "Yes \u2014 one 'Page templates' data-store container.",
        "by": "skill",
        "why": "They are read at runtime and are not code inside another process; C4 2.3 admits a file store as a container."
      },
      {
        "q": "Queues and topics?",
        "choice": "Not applicable \u2014 none detected.",
        "by": "skill",
        "why": "No broker, queue or topic appears anywhere in the plugin."
      }
    ]
  }
}
